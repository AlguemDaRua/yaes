# Normalise line endings for all text files
* text=auto eol=lf

# Force LF for Dart/Flutter source
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.cmake text eol=lf
*.h    text eol=lf
*.cc   text eol=lf

# Keep CRLF for Windows-specific files
*.bat  text eol=crlf
*.cmd  text eol=crlf
